# What belongs in the repository and what does not is explained in
# CONTRIBUTING.md, section "What is in the repository, and what stays local".

# Dependencies and generated output
node_modules/
coverage/
stats.json
jest-*.json
*.tsbuildinfo

# Captured from the game: carries account data, and stale within days
INPUT/
scripts/catalogue/out/
docs/reference/diagrams/

# The local workspace: notes, drafts, reports, logs -- anything only this
# machine needs. Personal files outside it belong in .git/info/exclude.
local/
*.log
_logs_*/

# Assistant and editor state
.claude/
.kiro/
.vscode/
.idea/
*.swp
*.swo
*.bak
*.orig
*.tmp

# OS index files
.DS_Store
Thumbs.db
